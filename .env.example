# Create a bot at https://discord.com/developers/applications and rotate any
# credential that has ever appeared in source code.
DISCORD_TOKEN=<replace-me>

# Choose providers independently: groq or openai.
# Only the keys for enabled providers are required.
STT_PROVIDER=groq
SUMMARY_PROVIDER=groq
GROQ_API_KEY=<replace-me>
OPENAI_API_KEY=<replace-me>

# Comma-separated Discord user IDs permitted to use the private bot.
ALLOWED_USER_IDS=<replace-me>

# Paths are resolved relative to the project unless absolute.
DATA_ROOT=.
VOICE_LOG_DIR=voice_logs
DATABASE_PATH=transcripts.db
LOG_DIR=logs

# Groq defaults (used when SUMMARY_PROVIDER=groq and no explicit override).
SUMMARY_MODEL=openai/gpt-oss-120b
SUMMARY_MODEL_FALLBACK=openai/gpt-oss-20b
# OpenAI defaults (used when SUMMARY_PROVIDER=openai and no explicit override).
#OPENAI_SUMMARY_MODEL=gpt-4o-mini
#OPENAI_SUMMARY_FALLBACK_MODEL=gpt-4o-mini
# Transcription default depends on STT_PROVIDER: whisper-large-v3 (groq) or whisper-1 (openai).
TRANSCRIPTION_MODEL=
# Optional ISO-639-1 hint such as en or ar; empty enables auto-detection.
TRANSCRIPTION_LANGUAGE=
MAX_FILE_SIZE_MB=25
MAX_CONCURRENT_JOBS=2
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_RETRIES=2
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2

TIMEZONE=UTC
